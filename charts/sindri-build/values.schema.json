{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "sindri-build values",
  "type": "object",
  "additionalProperties": false,
  "required": ["app", "owner", "runner", "labels", "openbao"],
  "if": { "not": { "properties": { "build": { "const": false } }, "required": ["build"] } },
  "then": { "properties": { "labels": { "required": ["sindri"] } } },
  "properties": {
    "app": {
      "description": "The app's name (the Meru/<app> repo); the namespace is <app>-build.",
      "type": "string",
      "pattern": "^[a-z]([-a-z0-9]{0,40}[a-z0-9])?$"
    },
    "owner": { "type": "string", "pattern": "^[a-z0-9]([-a-z0-9_.]{0,61}[a-z0-9])?$" },
    "runner": {
      "type": "object",
      "additionalProperties": false,
      "required": ["image"],
      "properties": {
        "image": { "$ref": "#/definitions/image" },
        "timeout": { "type": "string", "pattern": "^[0-9]+(s|m|h)$" }
      }
    },
    "build": {
      "description": "false: a check-only runner - no `sindri` label, no signer account, no OpenBao.",
      "type": "boolean"
    },
    "labels": {
      "description": "Runner label -> job image. `sindri` (the build) is required unless build is false, which ignores it.",
      "type": "object",
      "minProperties": 1,
      "propertyNames": { "pattern": "^[a-z][-a-z0-9]{0,30}$" },
      "additionalProperties": { "$ref": "#/definitions/image" }
    },
    "jobResources": { "$ref": "#/definitions/resources" },
    "serviceResources": { "$ref": "#/definitions/resources" },
    "buildMemoryLimit": { "type": "string" },
    "network": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled", "nodeAddress", "host", "registry"],
      "properties": {
        "enabled": { "type": "boolean" },
        "nodeAddress": { "type": "string", "pattern": "^[0-9.]+/[0-9]+$" },
        "host": {
          "type": "object",
          "additionalProperties": false,
          "required": ["address", "ports"],
          "properties": {
            "address": { "type": "string", "pattern": "^[0-9.]+$" },
            "ports": { "type": "array", "minItems": 1, "items": { "type": "integer" } }
          }
        },
        "registry": {
          "type": "object",
          "additionalProperties": false,
          "required": ["namespace", "port"],
          "properties": {
            "namespace": { "type": "string" },
            "port": { "type": "integer" }
          }
        }
      }
    },
    "openbao": {
      "type": "object",
      "additionalProperties": false,
      "required": ["addr", "refreshInterval", "caCert"],
      "properties": {
        "addr": { "type": "string", "pattern": "^https://" },
        "refreshInterval": { "type": "string", "pattern": "^[0-9]+(s|m|h)$" },
        "caCert": { "type": "string", "pattern": "-----BEGIN CERTIFICATE-----" }
      }
    },
    "ephemeral": {
      "description": "One-job runners started by KEDA instead of the always-on runner.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean" },
        "queueUrl": { "type": "string", "pattern": "^https?://" },
        "pollingInterval": { "type": "integer", "minimum": 5 },
        "maxRunners": { "type": "integer", "minimum": 1, "maximum": 4 },
        "activeDeadlineSeconds": { "type": "integer", "minimum": 600 }
      }
    },
    "global": { "type": "object" }
  },
  "definitions": {
    "image": {
      "description": "A fully qualified image pinned by digest.",
      "type": "string",
      "pattern": "^[a-z0-9.-]+(:[0-9]+)?(/[a-z0-9._-]+)+(:[A-Za-z0-9_][A-Za-z0-9_.-]{0,127})?@sha256:[a-f0-9]{64}$"
    },
    "resources": {
      "type": "object",
      "additionalProperties": false,
      "required": ["requests", "limits"],
      "properties": {
        "requests": {
          "type": "object",
          "additionalProperties": false,
          "required": ["cpu", "memory"],
          "properties": {
            "cpu": { "type": ["string", "number"] },
            "memory": { "type": "string" }
          }
        },
        "limits": {
          "type": "object",
          "additionalProperties": false,
          "required": ["memory"],
          "properties": {
            "cpu": { "type": ["string", "number"] },
            "memory": { "type": "string" }
          }
        }
      }
    }
  }
}
